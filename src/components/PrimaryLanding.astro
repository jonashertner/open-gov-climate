    imageAlt: 'Riverflow: charta da la rait d’auas svizra cun flums, serras e glatschers', live: 'Riverflow · Live',
    goalLabel: 'La finamira', goalTitle: 'L’entir circul da l’aua, visibel ensemen.',
    goalText: 'La charta collia oz quantitad d’aua, temperatura, qualitad, accumulaziun, glatschers, aua sutterrana, territoris umids ed utilisaziun. Quai che manca vegn numnà, betg zuppentà.',
    cycle: ['Precipitaziun', 'Naiv e glatsch', 'Funtaunas ed aua sutterrana', 'Auals e flums', 'Lais e territoris umids', 'Utilisaziun e return', 'Evapuraziun'],
    cycleNote: 'Intginas parts èn gia cartadas; las autras mussan las proximas cumplettaziuns da datas.',
    mission: [
      ['01', 'Chapir', 'Mesiraziuns, inventaris, funtaunas e vegliadetgna vegnan legibels ensemen.'],
      ['02', 'Proteger', 'Ils curs d’aua essenzials ed ils territoris umids vegnan visibels e controllabels.'],
      ['03', 'Far valair', 'Obligaziuns giuridicas vegnan cumparegliadas cun datas – e la protecziun vegn pretendida legalmain sche necessari.'],
    ],
    collabLabel: 'Avert e collaborativ', collabTitle: 'Quest project dovra savida speziala.',
    collabText: 'Nus envidain la scienza, il dretg, las autoritads, la societad civila e persunas spezialisadas localas. Datas, examinaziun da metodas, analisa giuridica e code èn bainvegnids.',
    contribute: 'Proponer ina contribuziun', github: 'Collavurar sin GitHub',
    archive: 'Open Gov Climate concentrescha per il mument sia lavur sin Riverflow. Il project precedent davart evidenzas ecologicas resta conservà per ina revisiun pli tard.',
    archiveLink: 'Project precedent · Archiv', footer: 'Datas avertas. Metodas avertas. Protecziun efficazia.',
  },
} as const;

const c = copy[lang];
const languagePaths: Record<LandingLang, string> = { de: '/', en: '/en/', fr: '/fr/', it: '/it/', rm: '/rm/' };
const archivePath = lang === 'rm' ? '/archive/' : `/archive/${lang}/`;
const riverPath = lang === 'de' ? '/riverflow/' : `/riverflow/${lang}/`;
const riverDoc = (file: string) => `${riverPath}${file}`;
---

<PublicBase title={c.title} description={c.meta} lang={lang} skipLabel={c.skip}>
  <header class="landing-head">
    <a class="landing-brand" href={languagePaths[lang]} aria-label={c.home}>
      <span class="landing-mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>Open Gov Climate</span>
    </a>
    <nav class="landing-nav" aria-label="Riverflow">
      <a aria-current="page" href={riverPath}>{c.nav[0]}</a>
      <a href={riverDoc('method.html')}>{c.nav[1]}</a>
      <a href={riverDoc('sources.html')}>{c.nav[2]}</a>
      <a href={riverDoc('about.html#collaborate')}>{c.nav[3]}</a>
    </nav>
    <nav class="landing-langs" aria-label="Language">
      {(Object.entries(languagePaths) as [LandingLang, string][]).map(([code, href]) => (
        code === lang
          ? <span aria-current="page">{code.toUpperCase()}</span>
          : <a href={href} hreflang={code} lang={code}>{code.toUpperCase()}</a>
      ))}
    </nav>
  </header>

  <main id="main">
    <section class="landing-hero" aria-labelledby="landing-title">
      <div class="hero-copy">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1 id="landing-title">{c.title1}<br />{c.title2}</h1>
        <p class="hero-lead">{c.lead}</p>
        <div class="hero-actions">
          <a class="primary-action" href={riverPath}>{c.open} <span aria-hidden="true">→</span></a>
          <a class="text-action" href={riverDoc('about.html')}>{c.understand}</a>
        </div>
      </div>
      <a class="project-visual" href={riverPath} aria-label={c.open} data-live={c.live}>
        <img src="/riverflow-preview.jpg" width="1200" height="630" alt={c.imageAlt} />
      </a>
    </section>

    <section class="cycle-section" aria-labelledby="cycle-title">
      <div class="section-intro">
        <p class="eyebrow">{c.goalLabel}</p>
        <h2 id="cycle-title">{c.goalTitle}</h2>
        <p>{c.goalText}</p>
      </div>
      <ol class="cycle-path">
        {c.cycle.map((stage, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{stage}</li>)}
      </ol>
      <p class="cycle-note">{c.cycleNote}</p>
    </section>

    <section class="mission-section" aria-label={c.goalLabel}>
      {c.mission.map(([number, heading, text]) => (
        <article class="mission-item">
          <span>{number}</span><h2>{heading}</h2><p>{text}</p>
        </article>
      ))}
    </section>

    <section class="collab-section" aria-labelledby="collab-title">
      <div>
        <p class="eyebrow">{c.collabLabel}</p>
        <h2 id="collab-title">{c.collabTitle}</h2>
      </div>
      <div class="collab-copy">
        <p>{c.collabText}</p>
        <div class="hero-actions">
          <a class="primary-action" href={riverDoc('about.html#collaborate')}>{c.contribute} <span aria-hidden="true">→</span></a>
          <a class="text-action" href="https://github.com/jonashertner/riverflow-ch">{c.github}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="landing-footer">
    <div><b>Open Gov Climate</b><p>{c.footer}</p></div>
    <div class="archive-note"><p>{c.archive}</p><a href={archivePath}>{c.archiveLink}</a></div>
  </footer>
</PublicBase>
