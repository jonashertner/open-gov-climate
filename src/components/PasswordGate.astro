---
/**
 * Access gate for the pre-public phase.
 *
 * IMPORTANT — this is a speed bump, not security. The site is statically hosted
 * on GitHub Pages, which has no server-side auth, so every page's HTML, the
 * Pagefind index, /data.json and /rss.xml all remain fetchable by direct URL
 * regardless of what this component does. What it achieves is that a casual
 * visitor cannot browse the site, and that its unfinished status is obvious.
 * The `noindex` meta tag and /robots.txt do the heavier lifting by keeping the
 * site out of search results.
 *
 * Before the first real compliance finding is published, replace this with real
 * access control (Cloudflare Access, Netlify password protection, or Caddy
 * basic_auth on the existing Hetzner box).
 *
 * The password is hashed at build time so the plaintext never reaches the
 * browser. That only defeats view-source; the digest of a dictionary word is
 * trivially reversible.
 */
import { createHash } from 'node:crypto';

const password = import.meta.env.SITE_PASSWORD ?? 'hamlet';
const digest = createHash('sha256').update(password, 'utf8').digest('hex');
const storageKey = 'ogc.unlock.v1';
---

{/* Runs before paint. The lock is in the static markup and is *removed* here,
    so a no-JS visitor and the pre-hydration frame both stay locked. */}
<script is:inline define:vars={{ digest, storageKey }}>
  (function () {
    try {
      if (localStorage.getItem(storageKey) === digest) {
        document.documentElement.classList.remove('gate-locked');
      }
    } catch (e) {
      /* storage blocked (private mode, cookies off) — stay locked */
    }
  })();
</script>

<div id="gate" role="dialog" aria-modal="true" aria-labelledby="gate-title">
  <form id="gate-form" autocomplete="off">
    <h1 id="gate-title">Open Gov Climate</h1>
    <p class="gate-note">
      This site is in preparation and not yet public. Enter the access phrase to continue.
    </p>
    <label class="gate-label" for="gate-input">Access phrase</label>
    <input
      id="gate-input"
      type="password"
      name="password"
      autocomplete="current-password"
      aria-describedby="gate-error"
      required
    />
    <button type="submit">Enter</button>
    <p id="gate-error" class="gate-error" role="alert" hidden>Incorrect — try again.</p>
  </form>
</div>

<script is:inline define:vars={{ digest, storageKey }}>
  (function () {
    var form = document.getElementById('gate-form');
    var input = document.getElementById('gate-input');
    var error = document.getElementById('gate-error');
    if (!form || !input || !error) return;

    if (document.documentElement.classList.contains('gate-locked')) {
      input.focus();
    }

    async function sha256Hex(text) {
      var bytes = new TextEncoder().encode(text);
      var buffer = await crypto.subtle.digest('SHA-256', bytes);
      return Array.from(new Uint8Array(buffer))
        .map(function (b) {
          return b.toString(16).padStart(2, '0');
        })
        .join('');
    }

    form.addEventListener('submit', async function (event) {
      event.preventDefault();
      error.hidden = true;
      var entered;
      try {
        entered = await sha256Hex(input.value);
      } catch (e) {
        // crypto.subtle needs a secure context; http://<lan-ip> would land here.
        error.textContent = 'This browser context cannot verify the phrase (needs HTTPS).';
        error.hidden = false;
        return;
      }
      if (entered !== digest) {
        error.textContent = 'Incorrect — try again.';
        error.hidden = false;
        input.value = '';
        input.focus();
        return;
      }
      try {
        localStorage.setItem(storageKey, digest);
      } catch (e) {
        /* unlock for this page view only */
      }
      document.documentElement.classList.remove('gate-locked');
    });
  })();
</script>

<style is:global>
  /* The lock itself — `display: none` on every non-gate child of <body>, and
     the gate's own show/hide — is deliberately NOT here. It is inlined in
     <head> by Base.astro so it cannot fail to load. This file holds only
     appearance; if it never arrives, the site stays locked and merely looks
     plain. Hiding siblings (rather than relying on z-index) means no stacking
     context elsewhere in the page can punch through the overlay. */
  html.gate-locked #gate {
    position: fixed;
    inset: 0;
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: var(--paper, #fff);
  }

  #gate form {
    width: 100%;
    max-width: 22rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  #gate h1 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink, #111);
  }

  #gate .gate-note {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted, #666);
  }

  #gate .gate-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted, #666);
  }

  #gate input {
    padding: 0.6rem 0.7rem;
    font: inherit;
    font-size: 0.9375rem;
    color: var(--ink, #111);
    background: var(--paper, #fff);
    border: 1px solid var(--border, #d4d4d4);
    border-radius: 4px;
  }

  #gate input:focus-visible {
    outline: 2px solid var(--ink, #111);
    outline-offset: 1px;
  }

  #gate button {
    padding: 0.6rem 0.7rem;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--paper, #fff);
    background: var(--ink, #111);
    border: 1px solid var(--ink, #111);
    border-radius: 4px;
    cursor: pointer;
  }

  #gate .gate-error {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--status-red, #b00020);
  }
</style>
