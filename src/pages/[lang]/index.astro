---
import PrimaryLanding from '../../components/PrimaryLanding.astro';

type LandingLang = 'de' | 'en' | 'fr' | 'it' | 'rm';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'rm' } },
  ];
}

const { lang } = Astro.params as { lang: LandingLang };
---

<PrimaryLanding lang={lang} />
