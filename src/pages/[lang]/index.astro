---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import FOIACard from '../../components/FOIACard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Contact from '../../components/Contact.astro';
import { t, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };

const allFoia = await getCollection('foia');
const foiaEntries = allFoia
  .filter(f => f.data.lang === lang)
  .sort((a, b) => b.data.dateSubmitted.getTime() - a.data.dateSubmitted.getTime());

const allArticles = await getCollection('articles');
const articleEntries = allArticles
  .filter(a => a.data.lang === lang)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title={t(lang, 'site.title')} description={t(lang, 'site.description')} lang={lang}>
  <Header slot="header" />

  <Hero lang={lang} />

  <section id="foia" class="section">
    <div class="container">
      <div class="section__header">
        <p class="label">{t(lang, 'foia.label')}</p>
        <h2>{t(lang, 'foia.heading')}</h2>
      </div>
      <div class="grid-2">
        {foiaEntries.map(entry => (
          <FOIACard entry={entry} lang={lang} />
        ))}
      </div>
    </div>
  </section>

  <section id="map" class="section map-section">
    <div class="container">
      <div class="section__header">
        <p class="label">{t(lang, 'map.label')}</p>
        <h2>{t(lang, 'map.heading')}</h2>
      </div>
    </div>
    <div class="map-container" id="map-root" data-foia={JSON.stringify(foiaEntries.map(f => ({
      slug: f.data.slug,
      title: f.data.title,
      lat: f.data.coordinates.lat,
      lng: f.data.coordinates.lng,
      status: f.data.status,
      category: f.data.category,
      url: `/${lang}/foia/${f.data.slug}/`,
    })))}></div>
  </section>

  <section id="articles" class="section">
    <div class="container">
      <div class="section__header">
        <p class="label">{t(lang, 'articles.label')}</p>
        <h2>{t(lang, 'articles.heading')}</h2>
        <p class="section__subheading">{t(lang, 'articles.subheading')}</p>
      </div>
      <div class="grid-2">
        {articleEntries.map(entry => (
          <ArticleCard entry={entry} lang={lang} />
        ))}
      </div>
    </div>
  </section>

  <Contact lang={lang} />

  <Footer slot="footer" />
</Base>

<style>
  .section__header { margin-bottom: var(--space-12); }
  .section__header h2 { margin-top: var(--space-3); }
  .section__subheading { margin-top: var(--space-3); color: var(--muted); }
  .map-container { width: 100%; height: 70vh; min-height: 400px; }
</style>

<script>
  const mapRoot = document.getElementById('map-root');
  if (mapRoot) {
    import('../../components/MapIsland.js').then(({ initMap }) => {
      const data = JSON.parse(mapRoot.dataset.foia || '[]');
      initMap(mapRoot, data);
    });
  }
</script>
