---
import HomePage from '../../components/HomePage.astro';
import { type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
---

<HomePage lang={lang} />
