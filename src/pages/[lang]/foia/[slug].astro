---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import StatusTracker from '../../../components/StatusTracker.astro';
import PDFViewer from '../../../components/PDFViewer.tsx';
import ShareCite from '../../../components/ShareCite.astro';
import FOIACard from '../../../components/FOIACard.astro';
import { t, type Lang } from '../../../i18n/utils';

export async function getStaticPaths() {
  const entries = await getCollection('foia');
  return entries.map(entry => ({
    params: { lang: entry.data.lang, slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { lang } = Astro.params as { lang: Lang };
const { Content } = await render(entry);

const allFoia = await getCollection('foia');
const related = allFoia.filter(f =>
  f.data.lang === lang &&
  entry.data.relatedSlugs.includes(f.data.slug)
);
---

<Base title={entry.data.title} description={entry.data.summary} lang={lang}>
  <Header slot="header" />

  <article class="foia-detail container">
    <a href={`/${lang}/#foia`} class="back-link">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      {t(lang, 'foia.backLink')}
    </a>

    <StatusTracker
      status={entry.data.status}
      dateSubmitted={entry.data.dateSubmitted}
      dateAcknowledged={entry.data.dateAcknowledged}
      dateResponded={entry.data.dateResponded}
      datePublished={entry.data.datePublished}
      lang={lang}
    />

    <header class="foia-detail__header">
      <p class="label">{entry.data.category}</p>
      <h1>{entry.data.title}</h1>
      <dl class="foia-detail__meta">
        <div><dt>Authority</dt><dd>{entry.data.authority}</dd></div>
        <div><dt>Legal Basis</dt><dd class="mono">{entry.data.legalBasis}</dd></div>
        <div><dt>Date Filed</dt><dd class="mono">{entry.data.dateSubmitted.toISOString().split('T')[0]}</dd></div>
      </dl>
    </header>

    <div class="prose">
      <Content />
    </div>

    <div class="foia-detail__documents">
      <PDFViewer client:visible src={entry.data.requestPdf} label={t(lang, 'foia.downloadRequest')} downloadLabel="Download" />
      {entry.data.responsePdf && (
        <PDFViewer client:visible src={entry.data.responsePdf} label={t(lang, 'foia.downloadResponse')} downloadLabel="Download" />
      )}
    </div>

    <ShareCite
      title={entry.data.title}
      url={`https://opengovclimate.ch/${lang}/foia/${entry.data.slug}/`}
      date={entry.data.dateSubmitted}
      lang={lang}
    />

    {related.length > 0 && (
      <section class="foia-detail__related">
        <h2>{t(lang, 'foia.relatedRequests')}</h2>
        <div class="grid-2">
          {related.map(r => <FOIACard entry={r} lang={lang} />)}
        </div>
      </section>
    )}
  </article>

  <Footer slot="footer" />
</Base>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    text-decoration: none;
    margin-bottom: var(--space-8);
  }

  .foia-detail__header {
    margin-top: var(--space-8);
  }

  .foia-detail__header h1 {
    margin-top: var(--space-3);
  }

  .foia-detail__meta {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .foia-detail__meta dt {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--muted);
  }

  .foia-detail__meta dd {
    margin-top: var(--space-1);
  }

  .foia-detail .prose {
    margin-top: var(--space-12);
  }

  .foia-detail__documents {
    margin-top: var(--space-12);
    display: grid;
    gap: var(--space-8);
  }

  .foia-detail__related {
    margin-top: var(--space-16);
  }

  .foia-detail__related h2 {
    margin-bottom: var(--space-8);
  }
</style>
