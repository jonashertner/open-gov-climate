---
import '../styles/global.css';
import Search from '../components/Search.tsx';
import PasswordGate from '../components/PasswordGate.astro';
import { t, type Lang } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  ogImage?: string;
}

// NOTE: never place a comment or any markup before <!DOCTYPE html> or between
// it and <html>. The Astro compiler then drops the <html> element from the
// output, which silently breaks Pagefind ("pages found without an <html>
// element") and leaves the build with an empty search index.
//
// <html> carries class="gate-locked" in the static markup; PasswordGate's
// inline head script removes it once a valid unlock is stored. Locking in the
// markup and unlocking in JS means the gate fails closed for no-JS visitors and
// shows no flash of content before hydration.
const { title, description = 'Swiss transparency initiative for alpine climate intervention projects.', lang = 'en', ogImage } = Astro.props;
const typedLang = lang as Lang;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const supportedLangs = ['en', 'de', 'fr', 'it'];
---

<!DOCTYPE html>
<html lang={lang} class="gate-locked">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — Open Gov Climate</title>
  <meta name="description" content={description} />
  {/* Not public yet. This, with /robots.txt, is what actually keeps the site
      out of view — the access gate below is only a speed bump. */}
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  {supportedLangs.map(l => (
    <link rel="alternate" hreflang={l} href={new URL(`/${l}${Astro.url.pathname.replace(/^\/(en|de|fr|it)/, '')}`, Astro.site)} />
  ))}

  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${title} — Open Gov Climate`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  {ogImage && <meta property="og:image" content={ogImage} />}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} — Open Gov Climate`} />
  <meta name="twitter:description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />

  {/* The lock lives here, inline and render-blocking, NOT in the bundled
      stylesheet. A gate that depends on a second network request is not a gate:
      if /_astro/*.css is slow, stale or missing, an external rule would leave
      the whole site visible. These four declarations are the entire lock; the
      gate's cosmetic styling stays in PasswordGate.astro where it belongs. */}
  <style is:inline>
    html.gate-locked { overflow: hidden; }
    html.gate-locked body > *:not(#gate) { display: none !important; }
    #gate { display: none; }
    html.gate-locked #gate { display: flex; }
  </style>

  <script is:inline>
    (function() {
      var theme = localStorage.getItem('theme');
      if (theme) {
        document.documentElement.setAttribute('data-theme', theme);
      }
    })();
  </script>
</head>
<body>
  <PasswordGate />
  <a class="skip-link" href="#main-content">Skip to content</a>
  <slot name="header" />
  <main id="main-content" data-pagefind-body>
    <slot />
  </main>
  <slot name="footer" />
  <Search client:idle placeholder={t(typedLang, 'search.placeholder')} noResults={t(typedLang, 'search.noResults')} resultsLabel={t(typedLang, 'search.results')} />
</body>
</html>
